# LandGuard AI — Backend Environment Configuration
PROJECT_NAME="LandGuard AI"
ENVIRONMENT="production"
LOG_LEVEL="INFO"
ALLOWED_ORIGINS="http://localhost:5173,https://land-guard-ai.vercel.app,https://landguard-ai.vercel.app"
ALLOW_VERCEL_PREVIEWS="true"
DEFAULT_ASSESSMENT_DATE="2026-10-15"

# Persistent Storage & Database
# Option 1: Managed PostgreSQL Connection String
# DATABASE_URL="postgresql://user:password@hostname:5432/dbname"

# Option 2: Persistent Disk Mount Path (for SQLite)
PERSISTENT_DATA_PATH="/data"

# Production Access Control Provisioning (Argon2id KDF)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ReplaceWithStrongAdminPassword"
REVIEWER_USERNAME="reviewer"
REVIEWER_PASSWORD="ReplaceWithStrongReviewerPassword"
